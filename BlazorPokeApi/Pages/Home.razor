@page "/"
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Text.RegularExpressions
@using BlazorPokeApi.Models
@inject HttpClient Http

<PageTitle>Buscar Pokémon</PageTitle>

<h1>Buscar Pokémon</h1>

@* <form> + @onsubmit permite buscar também com a tecla Enter. *@
<form @onsubmit="BuscarPokemon">
    <div class="form-group">
        <label for="nomeInput">Nome do Pokémon:</label>
        <input type="text" class="form-control" id="nomeInput" @bind="nomeDigitado"
               placeholder="Ex: pikachu" maxlength="50" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-primary mt-2" disabled="@carregando">
        @(carregando ? "Buscando..." : "Buscar Pokémon")
    </button>
</form>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger mt-4">@mensagemErro</div>
}

@if (pokemon != null)
{
    <hr />
    <h3>Detalhes do Pokémon</h3>

    @if (!string.IsNullOrWhiteSpace(UrlImagem))
    {
        <img src="@UrlImagem" alt="@pokemon.Nome" class="pokemon-img" />
    }
    else
    {
        <p class="text-muted"><em>Imagem oficial não disponível para este Pokémon.</em></p>
    }

    <p><strong>ID:</strong> @pokemon.Id</p>
    <p><strong>Nome:</strong> @pokemon.Nome</p>
    <p><strong>Altura:</strong> @FormatarDecimal(pokemon.Altura / 10.0) m</p>
    <p><strong>Peso:</strong> @FormatarDecimal(pokemon.Peso / 10.0) kg</p>
}

@code {
    private const string UrlPokeApi = "https://pokeapi.co/api/v2/pokemon/";

    // Nomes da PokéAPI usam só letras minúsculas, números e hífen (ex.: "mr-mime", "ho-oh").
    // Validar antes evita chamadas inúteis e impede montar URLs com caracteres arbitrários.
    private static readonly Regex NomeValido = new("^[a-z0-9-]+$", RegexOptions.Compiled);

    private string? nomeDigitado;
    private Pokemon? pokemon;
    private string? mensagemErro;
    private bool carregando;

    // Exigência da atividade: a imagem vem obrigatoriamente de sprites.other["official-artwork"].front_default.
    private string? UrlImagem => pokemon?.Sprites?.Outros?.ArteOficial?.FrontDefault;

    private async Task BuscarPokemon()
    {
        mensagemErro = string.Empty;
        pokemon = null;

        // A API diferencia maiúsculas: "Pikachu" retorna 404, então normalizamos.
        var nome = nomeDigitado?.Trim().ToLowerInvariant().Replace(' ', '-');

        if (string.IsNullOrEmpty(nome))
        {
            mensagemErro = "Por favor, digite o nome do Pokémon.";
            return;
        }

        if (!NomeValido.IsMatch(nome))
        {
            mensagemErro = "O nome deve conter apenas letras, números ou hífen (ex.: pikachu, mr-mime).";
            return;
        }

        carregando = true;

        try
        {
            using var resposta = await Http.GetAsync(UrlPokeApi + nome);

            if (resposta.StatusCode == HttpStatusCode.NotFound)
            {
                mensagemErro = $"Pokémon \"{nome}\" não encontrado.";
                return;
            }

            resposta.EnsureSuccessStatusCode();
            pokemon = await resposta.Content.ReadFromJsonAsync<Pokemon>();

            if (pokemon == null)
            {
                mensagemErro = "A PokéAPI retornou uma resposta vazia.";
            }
        }
        catch (HttpRequestException ex)
        {
            mensagemErro = $"Erro ao conectar à PokéAPI: {ex.Message}";
        }
        catch (JsonException)
        {
            mensagemErro = "A PokéAPI retornou uma resposta em formato inesperado.";
        }
        catch (TaskCanceledException)
        {
            mensagemErro = "A PokéAPI demorou demais para responder. Tente novamente.";
        }
        finally
        {
            carregando = false;
        }
    }

    // Formata com vírgula decimal (0,4 / 6) sem depender da cultura do navegador,
    // que no WebAssembly pode não ter os dados de pt-BR carregados.
    private static string FormatarDecimal(double valor) =>
        valor.ToString("0.##", CultureInfo.InvariantCulture).Replace('.', ',');
}
